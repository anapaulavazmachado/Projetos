 def verificar(i,j) :

  numero_i = str(i)

  numero_j = str(j)

  tamanho_i = len(numero_i)

  tamanho_j = len(numero_j)

  for a in range (tamanho_j - tamanho_i + 1):

    calcular = numero_j[a : a + tamanho_i]

    if calcular == numero_i :

       print(f"{i} é uma parte do número de {j}")

       return True

  print(f"{i} não é uma parte do número de {j}")

  return False



