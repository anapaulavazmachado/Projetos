def encontrar_maior_segmento(numeros):

  if not numeros:

    return []



  maior_segmento = []

  segmento_atual = [numeros[0]]



  for i in range(1, len(numeros)):

    if numeros[i] > numeros[i - 1]:

      segmento_atual.append(numeros[i])

    else:

      if len(segmento_atual) > len(maior_segmento):

        maior_segmento = segmento_atual

      segmento_atual = [numeros[i]]

  if len(segmento_atual) > len(maior_segmento):

    maior_segmento = segmento_atual

  return maior_segmento

